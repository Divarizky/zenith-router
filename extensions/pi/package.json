{
  "name": "pi-zenith-router",
  "version": "0.1.0",
  "description": "pi extension for zenith-router: registers the zenith-router provider, reports gateway status, and publishes quota for usage-tracker",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "keywords": [
    "pi",
    "pi-extension",
    "zenith-router"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
